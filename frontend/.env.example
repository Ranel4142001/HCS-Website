# Environment Variables — Example Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# On your hosting provider, set these in the project's environment settings.

# ─── Site ─────────────────────────────────────────
# Public production domain. Used for canonical URLs, sitemap.xml, robots.txt and social previews.
NEXT_PUBLIC_SITE_URL=https://healthcredstat.com

# ─── Client portal ────────────────────────────────
# Address of the separate client portal. While empty, "Sign in" opens a holding page at /sign-in.
NEXT_PUBLIC_PORTAL_URL=

# ─── Contact form → Monday ────────────────────────
# Server-only (no NEXT_PUBLIC_ prefix): each form submission becomes an item on this Monday board.
# Token: Monday profile → Developers → My access tokens. The token's user must be a member of the board.
MONDAY_API_TOKEN=
# The number in the board's URL, e.g. https://<account>.monday.com/boards/18438098900
MONDAY_BOARD_ID=
